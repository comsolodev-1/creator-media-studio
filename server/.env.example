PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
IP_SALT=change-this-to-a-different-long-random-string
NODE_ENV=development

# Neon (or any Postgres) connection string. Get this from your Neon project dashboard —
# it looks like: postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
# For local development without Neon, point this at any local Postgres instance instead.
DATABASE_URL=postgres://postgres:devpass@localhost:5432/creator_media_studio

# Optional: real SMTP for password-reset emails. Leave unset during development — email
# content is logged to the server console instead of sent (see server/email.js).
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# MAIL_FROM=no-reply@creator.com

# Used to build the link inside password-reset emails. Defaults to the request's own host if
# unset, which is fine for local dev but should be set explicitly once deployed.
# APP_URL=https://your-deployed-domain.com
